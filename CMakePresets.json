{
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_STANDARD": "23",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "KAAKELIT_USE_SANITIZERS": false
      }
    },
    {
      "name": "debug",
      "displayName": "GCC Debug",
      "inherits": [
        "base"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-san",
      "displayName": "GCC Debug with Sanitizers",
      "inherits": [
        "debug"
      ],
      "cacheVariables": {
        "KAAKELIT_USE_SANITIZERS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "GCC Debug",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    }
  ]
}
