{
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_STANDARD": "23",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "debug",
      "displayName": "GCC Debug",
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_FLAGS_DEBUG_INIT": "-Wall -Wextra -Werror",
        "CMAKE_CXX_FLAGS_DEBUG_INIT": "-Wall -Wextra -Werror"
      }
    }
  ]
}
